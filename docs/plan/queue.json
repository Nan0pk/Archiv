{
  "schema_version": "1",
  "plan_id": "ARCHIV-PLAN-1",
  "description": "Ordered, self-verifying work queue. Progress is derived by running each step's acceptance check, never by reading a status line. One step is one pull request.",
  "baseline_commit": "d9a9b8d",
  "phases": [
    {
      "id": "A",
      "title": "Make the product testable without local hardware",
      "goal": "archiv ask and archiv report can be exercised end to end against a clearly-labelled remote model, with local runtime predicted from a measured workload fingerprint. The loopback privacy boundary is pinned by tests before the remote adapter exists."
    },
    {
      "id": "B",
      "title": "Stop the tool overclaiming",
      "goal": "Every name, score and confidence value shown to a user is backed by a measurement or removed. The two genuinely useful capabilities in the September batch keep working under honest names."
    },
    {
      "id": "C",
      "title": "Recover the content being silently dropped",
      "goal": "Word, Excel and PowerPoint files yield their tables, notes, computed values and hyperlinks. Parity with the OpenDocument reader, which already does this correctly, is the acceptance test."
    },
    {
      "id": "D",
      "title": "Audio and video",
      "goal": "Recordings from phones and dictaphones are ingested and transcribed with timestamp citations. Video is decomposed into transcript, keyframes and metadata using the existing containment model."
    },
    {
      "id": "E",
      "title": "Faces and identity, properly",
      "goal": "A real detector, name candidates only from evidence a user can open, and entity extraction that works in Arabic script."
    }
  ],
  "acceptance_kinds": {
    "pytest": "targets are pytest node ids; the step is complete when all pass",
    "artifact": "targets are repo-relative paths; the step is complete when all exist and parse as valid JSON where the suffix is .json",
    "command": "targets are shell commands; the step is complete when all exit zero"
  },
