{
  "$defs": {
    "FieldTrialDecision": {
      "additionalProperties": false,
      "description": "Why parser work is selected rather than accumulated speculatively.",
      "properties": {
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "ranked_next_work": {
          "items": {
            "$ref": "#/$defs/RankedFormatDecision"
          },
          "minItems": 1,
          "title": "Ranked Next Work",
          "type": "array"
        }
      },
      "required": [
        "evidence",
        "method",
        "ranked_next_work"
      ],
      "title": "FieldTrialDecision",
      "type": "object"
    },
    "FormatFamily": {
      "additionalProperties": false,
      "description": "Verified behavior for one family of related formats.",
      "properties": {
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "suffixes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Suffixes",
          "type": "array"
        },
        "media_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Media Types",
          "type": "array"
        },
        "detection": {
          "minLength": 1,
          "title": "Detection",
          "type": "string"
        },
        "immutable_ingestion": {
          "title": "Immutable Ingestion",
          "type": "boolean"
        },
        "text_extraction": {
          "enum": [
            "native",
            "visual_ocr_conditional",
            "metadata_only"
          ],
          "title": "Text Extraction",
          "type": "string"
        },
        "structure": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Structure",
          "type": "array"
        },
        "locator_shapes": {
          "default": [],
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Locator Shapes",
          "type": "array"
        },
        "grounding": {
          "title": "Grounding",
          "type": "boolean"
        },
        "preview_render": {
          "minLength": 1,
          "title": "Preview Render",
          "type": "string"
        },
        "macros": {
          "minLength": 1,
          "title": "Macros",
          "type": "string"
        },
        "encryption": {
          "minLength": 1,
          "title": "Encryption",
          "type": "string"
        },
        "known_limits": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Known Limits",
          "type": "array"
        },
        "support_level": {
          "default": "full",
          "enum": [
            "full",
            "partial"
          ],
          "title": "Support Level",
          "type": "string"
        }
      },
      "required": [
        "family",
        "suffixes",
        "media_types",
        "detection",
        "immutable_ingestion",
        "text_extraction",
        "grounding",
        "preview_render",
        "macros",
        "encryption"
      ],
      "title": "FormatFamily",
      "type": "object"
    },
    "OutputFormat": {
      "additionalProperties": false,
      "description": "One document format Archiv itself produces through the report workflow.",
      "properties": {
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "format": {
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "generated": {
          "title": "Generated",
          "type": "boolean"
        },
        "verification": {
          "minLength": 1,
          "title": "Verification",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "format",
        "media_type",
        "generated",
        "verification"
      ],
      "title": "OutputFormat",
      "type": "object"
    },
    "RankedFormatDecision": {
      "additionalProperties": false,
      "description": "Evidence-ranked format or extraction limitation.",
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "format_or_limitation": {
          "minLength": 1,
          "title": "Format Or Limitation",
          "type": "string"
        },
        "decision": {
          "enum": [
            "implement",
            "measure",
            "defer"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "format_or_limitation",
        "decision",
        "reason"
      ],
      "title": "RankedFormatDecision",
      "type": "object"
    },
    "RejectedFormat": {
      "additionalProperties": false,
      "description": "One explicitly tested rejection case.",
      "properties": {
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "suffix": {
          "minLength": 1,
          "title": "Suffix",
          "type": "string"
        },
        "example": {
          "minLength": 1,
          "title": "Example",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "suffix",
        "example",
        "reason"
      ],
      "title": "RejectedFormat",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned, tested compatibility claims for the ingestion surface.",
  "properties": {
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "product_version": {
      "minLength": 1,
      "title": "Product Version",
      "type": "string"
    },
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "families": {
      "items": {
        "$ref": "#/$defs/FormatFamily"
      },
      "minItems": 1,
      "title": "Families",
      "type": "array"
    },
    "outputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OutputFormat"
      },
      "title": "Outputs",
      "type": "array"
    },
    "rejected_examples": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RejectedFormat"
      },
      "title": "Rejected Examples",
      "type": "array"
    },
    "field_trial_decision": {
      "$ref": "#/$defs/FieldTrialDecision"
    }
  },
  "required": [
    "product_version",
    "purpose",
    "families",
    "field_trial_decision"
  ],
  "title": "FormatMatrix",
  "type": "object"
}
